# Porkbun API credentials used by Caddy for ACME DNS-01 challenges.
# Copy this file to `caddy.env` and fill in real values from the Porkbun
# dashboard (Account -> API Access). Also enable "API Access" on each domain
# under Domain Management, or DNS-01 will fail.
#
# caddy.env is gitignored (matches the *.env rule), so secrets stay out of git.
PORKBUN_API_KEY=pk1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORKBUN_API_SECRET_KEY=sk1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
